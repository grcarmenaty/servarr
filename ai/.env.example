# Copy to .env (bootstrap.sh does it). Used by docker-compose.yml.

# Public URL of the chat UI (behind Caddy)
WEBUI_URL=http://chat.home.lan

# Account creation: leave true for the FIRST start only (first account
# created becomes admin). Then set false and `docker compose up -d`.
ENABLE_SIGNUP=true

# How long a model stays loaded in RAM after the last request
OLLAMA_KEEP_ALIVE=30m

# ── Voice (Wyoming services for Home Assistant) ────────────────────────────
# Whisper model: tiny-int8 (fastest) / base-int8 / small-int8 (good) /
# medium-int8 (best, slower on CPU)
WHISPER_MODEL=small-int8
WHISPER_LANGUAGE=es
# Voices: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=es_ES-davefx-medium
