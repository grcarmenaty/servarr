# Copy to .env and adjust. Used by docker-compose.yml (+ docker-compose.vpn.yml).

# Identity the containers run as — created by bootstrap.sh as user "media"
PUID=1000
PGID=1000

# Your timezone (schedulers, logs)
TZ=Europe/Madrid

# Where app configs live (on the VM root disk — fast, small, backed up)
CONFIG_ROOT=/opt/servarr/config

# Where the big data disk is mounted (media + downloads, single filesystem
# so hardlinks work)
DATA_ROOT=/mnt/data

# ── RomM (bootstrap.sh generates these) ────────────────────────────────────
ROMM_DB_PASSWORD=CHANGE-ME
ROMM_AUTH_SECRET_KEY=CHANGE-ME

# ── API keys (only needed if you uncomment unpackerr in the compose;
#    copy from each app's Settings → General after first-run) ──────────────
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=

# ── VPN — Proton VPN (only with docker-compose.vpn.yml) ───────────────────
# WireGuard private key from the Proton dashboard (Downloads → WireGuard):
# tick "NAT-PMP (Port Forwarding)", choose a P2P server, copy the key — it
# is shown ONLY at creation. Also: disable "Moderate NAT" in your Proton
# account when using port forwarding. (docs/08)
PROTON_WG_PRIVATE_KEY=
# Server country (Proton uses country/city names). Pick one with P2P servers.
PROTON_COUNTRIES=Netherlands
# Port forwarding improves torrent connectivity; needs a paid Proton plan and
# a PF-capable server. Set "off" to disable (then any server works).
PROTON_PORT_FORWARDING=on
