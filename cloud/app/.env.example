# Nextcloud app VM environment (cloud1 / cloud2) — bootstrap.sh generates
# .env; POSTGRES_PASSWORD and REDIS_PASSWORD must MATCH the cloud-data VM
# (its bootstrap prints them).

# cloud-data VM (Postgres, Redis, NFS)
CLOUDDATA_IP=10.0.0.22

# Caddy LXC (trusted reverse proxy)
CADDY_IP=10.0.0.6

# Must match cloud-data's .env
POSTGRES_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME

# Used only on the very first start (initial install, from cloud1)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE-ME

NEXTCLOUD_TRUSTED_DOMAINS=cloud.home.lan 10.0.0.23 10.0.0.24

# cloud1 only: also run the background-jobs container
#COMPOSE_PROFILES=cron
