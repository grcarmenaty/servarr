# Copy to .env and fill in — or let bootstrap.sh generate it with random
# secrets (recommended). Used by docker-compose.yml.

TZ=Europe/Madrid

# Where app configs + the postgres data live (VM root disk, backed up)
CONFIG_ROOT=/opt/cloud/config

# Where the big data disk is mounted (Nextcloud user files)
DATA_ROOT=/mnt/clouddata

# Caddy LXC IP (trusted reverse proxy)
CADDY_IP=10.0.0.6

# ── Nextcloud ──────────────────────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE-ME
NEXTCLOUD_TRUSTED_DOMAINS=cloud.home.lan 10.0.0.22

# ── Databases ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME
FIREFLY_DB_PASSWORD=CHANGE-ME

# ── Firefly III ────────────────────────────────────────────────────────────
# Exactly 32 random characters (bootstrap.sh generates this)
FIREFLY_APP_KEY=CHANGE-ME-32-CHARS-EXACTLY-12345
