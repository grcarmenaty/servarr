# cloud-data VM environment — bootstrap.sh generates .env with random
# secrets. The SAME POSTGRES_PASSWORD / REDIS_PASSWORD values must go into
# the app VMs' .env files (bootstrap prints them for you).

TZ=Europe/Madrid

# App configs + postgres data (VM root disk, backed up)
CONFIG_ROOT=/opt/cloud/config

# ── Databases / cache ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME
FIREFLY_DB_PASSWORD=CHANGE-ME

# ── Firefly III ────────────────────────────────────────────────────────────
# Exactly 32 random characters
FIREFLY_APP_KEY=CHANGE-ME-32-CHARS-EXACTLY-12345

# ── Bank connectivity (docs/10 "Connecting your banks") ────────────────────
# Personal Access Token from Firefly (Options → Profile → OAuth) — needed
# for the daily scheduled auto-import
FIREFLY_ACCESS_TOKEN=

# Enable Banking (enablebanking.com — free restricted mode, ~2500 EEA banks
# incl. Revolut): register an app, put its PEM key at
# /opt/cloud/config/firefly-importer/keys/enablebanking.pem, then set both:
ENABLE_BANKING_APP_ID=
#ENABLE_BANKING_PRIVATE_KEY_FILE=/keys/enablebanking.pem

# GoCardless Bank Account Data — legacy: only if you already have an account
NORDIGEN_ID=
NORDIGEN_KEY=

# Secret protecting the /autoimport endpoint (bootstrap generates this)
AUTO_IMPORT_SECRET=CHANGE-ME
