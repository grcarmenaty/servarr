# ── cloud tier — Nextcloud load-balanced across two app VMs ────────────────
# Sessions live in Redis, so no sticky sessions needed; health checks drop a
# dead backend within seconds and all traffic flows to the survivor.
http://cloud.@DOMAIN@ {
	reverse_proxy @CLOUD1_IP@:8080 @CLOUD2_IP@:8080 {
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 15s
		health_uri /status.php
		health_interval 10s
	}
}

