# Reverse proxy for the homelab — plain HTTP on the LAN (no cert warnings).
# Hostnames resolve via AdGuard DNS rewrites: *.@DOMAIN@ → this host
# (docs/09-core-services.md). @TOKENS@ are filled in at provision time.
#
# Want real HTTPS later? Buy a domain, use Caddy's ACME DNS challenge, and
# drop the http:// prefixes. For now only Vaultwarden (if you add it) needs
# TLS — see the commented block at the bottom.

# ── landing portal ─────────────────────────────────────────────────────────
http://@DOMAIN@, http://home.@DOMAIN@ {
	root * /var/www/home
	file_server
}

# ── infrastructure ─────────────────────────────────────────────────────────
http://proxmox.@DOMAIN@ {
	reverse_proxy https://@NODE1_IP@:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://dns.@DOMAIN@ {
	reverse_proxy @ADGUARD_IP@:80
}

http://status.@DOMAIN@ {
	reverse_proxy @KUMA_IP@:3001
}

# ntopng on node1 (each node has its own instance on :3000 — docs/13)
http://traffic.@DOMAIN@ {
	reverse_proxy @NODE1_IP@:3000
}

# Wazuh dashboard (self-signed HTTPS backend — docs/14)
http://siem.@DOMAIN@ {
	reverse_proxy https://@WAZUH_IP@:443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Guacamole remote-desktop portal (docs/15)
http://desktop.@DOMAIN@ {
	reverse_proxy @CLOUDDATA_IP@:8085
}

# AI assistant — Open WebUI, authenticated (docs/16)
http://chat.@DOMAIN@ {
	reverse_proxy @AI_IP@:3000
}

