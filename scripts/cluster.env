# Cluster configuration — edit to match your network plan (docs/02-network.md),
# then copy the whole scripts/ directory to /root/scripts on every node.
# All scripts source this file.

# Proxmox cluster name (letters/digits/hyphens)
CLUSTER_NAME="homelab"

# DNS-ish domain used in /etc/hosts entries
DOMAIN="home.lan"

# Node hostnames (must match what you set in the Proxmox installer)
NODE_NAMES=(node1 node2 node3)

# Management IPs (LAN / vmbr0), same order as NODE_NAMES.
# Make sure these are outside (or reserved in) the router's DHCP range.
NODE_IPS=(10.0.0.11 10.0.0.12 10.0.0.13)

# LAN gateway (the router)
LAN_GATEWAY="10.0.0.254"

# DNS server handed to VMs created by 10-create-servarr-vm.sh
LAN_DNS="10.0.0.254"

# Ceph public network CIDR — the 10 GbE full-mesh subnet (docs/02-network.md).
CEPH_NETWORK="10.10.10.0/24"

# Per-node mesh IPs, same order as NODE_NAMES. Used by 00-ceph-mesh-network.sh,
# corosync link1, and the health check. Leave the array empty () if you have
# no dedicated Ceph network.
CEPH_IPS=(10.10.10.11 10.10.10.12 10.10.10.13)

# MTU for the mesh links (9000 = jumbo frames; safe on direct point-to-point
# cables, both ends are configured identically by the script)
MESH_MTU=9000

# Name of the RBD pool for VM disks
VM_POOL="vm-pool"

# Create a CephFS for shared files (media, ISOs, backups)? yes/no
CREATE_CEPHFS="yes"
CEPHFS_NAME="cephfs"

# Per-OSD memory target in bytes. Default Ceph value is 4 GiB — correct for
# 64 GB nodes (5 OSDs × 4 GiB ≈ 20 GiB). Only lower this (2147483648 = 2 GiB)
# on nodes with <= 16 GB RAM.
OSD_MEMORY_TARGET=""

# Encrypt OSDs at rest (LUKS/dm-crypt)? yes/no. Keys live in the Ceph monitor
# store and unlock automatically at OSD start — a pulled/dead disk is
# unreadable, the running cluster is unaffected. See docs/05-ceph.md §4.
OSD_ENCRYPT="yes"

# Disable the "No valid subscription" login popup? yes/no
# (Cosmetic patch, reapplied automatically after pve-manager upgrades via apt hook.)
REMOVE_SUBSCRIPTION_NAG="yes"

# ---------------------------------------------------------------------------
# Core service LXCs — used by 11-create-core-lxcs.sh (docs/09).
# Parallel arrays: name / VMID / LAN IP / cores / RAM (MB)
# adguard2 is a second, independent DNS instance (hand out BOTH IPs via the
# router's DHCP → zero-downtime DNS even during node failures).
CORE_LXC_NAMES=(adguard caddy wireguard kuma adguard2 ntfy forgejo)
CORE_LXC_IDS=(101 102 103 104 105 106 107)
CORE_LXC_IPS=(10.0.0.5 10.0.0.6 10.0.0.7 10.0.0.8 10.0.0.9 10.0.0.10 10.0.0.14)
CORE_LXC_CORES=(1 1 1 2 1 1 2)
CORE_LXC_MEM=(1024 512 512 1024 1024 512 1024)
CORE_LXC_DISK_GB=8

# WireGuard: how clients reach home from the internet — your public DDNS
# hostname + forwarded UDP port (docs/09). Example: myhome.duckdns.org:51820
WG_ENDPOINT=""
WG_SUBNET="10.8.0.0/24"

# ---------------------------------------------------------------------------
# Home Assistant OS VM (optional) — used by 12-create-haos-vm.sh
HAOS_VMID=201
HAOS_VERSION="16.0"
HAOS_IP="10.0.0.21"       # HAOS uses DHCP — reserve this IP for it in the router

# ---------------------------------------------------------------------------
# Servarr VM (media stack) — used by 10-create-servarr-vm.sh (docs/08)
SERVARR_VMID=200
SERVARR_NAME="servarr"
SERVARR_IP="10.0.0.20"          # static LAN IP for the VM
SERVARR_CORES=6
SERVARR_MEMORY_MB=16384
SERVARR_ROOT_GB=32              # OS + docker + app configs
SERVARR_DATA_GB=5000            # media/downloads disk (thin-provisioned on Ceph)
SERVARR_USER="media"            # VM login user (cloud-init)

# ---------------------------------------------------------------------------
# Cloud tier (docs/10) — used by 13-create-cloud-vms.sh.
# cloud-data: Postgres + Redis + NFS (Nextcloud shared state) + Firefly III.
# cloud1/cloud2: two stateless Nextcloud app servers, load-balanced by Caddy
# and kept on different nodes by an HA anti-affinity rule (20-enable-ha.sh).
CLOUDDATA_VMID=202
CLOUDDATA_NAME="cloud-data"
CLOUDDATA_IP="10.0.0.22"
CLOUDDATA_CORES=4
CLOUDDATA_MEMORY_MB=10240       # Postgres+Valkey+Firefly+Paperless+Guacamole+SearXNG+Taiga
                                # +Karakeep+Grocy+Mealie+Homebox+FreshRSS+ArchiveBox+BookStack+Matrix
CLOUDDATA_ROOT_GB=32
CLOUDDATA_DATA_GB=500           # Nextcloud personal data (thin; IS backed up)

CLOUD_APP_VMIDS=(203 204)
CLOUD_APP_NAMES=(cloud1 cloud2)
CLOUD_APP_IPS=(10.0.0.23 10.0.0.24)
CLOUD_APP_CORES=4
CLOUD_APP_MEMORY_MB=4096
CLOUD_APP_ROOT_GB=32

CLOUD_USER="cloud"              # VM login user (cloud-init) on all three

# ---------------------------------------------------------------------------
# Wazuh SIEM VM (docs/14) — used by 15-create-wazuh-vm.sh
WAZUH_VMID=206
WAZUH_NAME="wazuh"
WAZUH_IP="10.0.0.26"
WAZUH_CORES=4
WAZUH_MEMORY_MB=8192
WAZUH_ROOT_GB=32
WAZUH_DATA_GB=150               # docker data-root (indexer storage)
WAZUH_VERSION="4.14.6"          # wazuh-docker tag: github.com/wazuh/wazuh-docker/releases

# ---------------------------------------------------------------------------
# AI VM (Ollama + Open WebUI + Whisper/Piper — docs/16), 16-create-ai-vm.sh.
# CPU inference by default → normal migratable, HA-enrollable VM.
# Optional: pass the GTX 960 through (16-create-ai-vm.sh --gpu <addr>) for
# small-model acceleration — that pins the VM to its node and drops HA.

# WHICH node hosts the GTX 960 (only matters for the optional passthrough
# and for GPU desktop VMs). Verify: lspci -nn | grep -i nvidia  on each node.
GPU_NODE="node2"

AI_VMID=207
AI_NAME="ai"
AI_IP="10.0.0.27"
AI_CORES=12                     # CPU inference loves threads
AI_MEMORY_MB=12288
AI_ROOT_GB=32
AI_DATA_GB=300                  # model storage (re-downloadable → backup=0)

# ---------------------------------------------------------------------------
# Photos VM (Immich — docs/11) — used by 14-create-photos-vm.sh
PHOTOS_VMID=205
PHOTOS_NAME="photos"
PHOTOS_IP="10.0.0.25"
PHOTOS_CORES=4
PHOTOS_MEMORY_MB=8192           # Immich ML wants headroom
PHOTOS_ROOT_GB=32
PHOTOS_DATA_GB=1000             # photo library (thin; IS backed up)
